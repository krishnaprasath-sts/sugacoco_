NODE_ENV=development
PORT=5050

# XAMPP MySQL (dev). On Webuzo, use the DB user/password created in the panel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sugacoco_db

# Used from Phase 2 (login). Use a long random string in production.
JWT_SECRET=change-me

# Keep outside the app folder in production so redeploys don't delete files.
UPLOAD_DIR=./uploads

CLIENT_ORIGIN=http://localhost:5180

# Customer tracking links: https://<PUBLIC_APP_URL>/track/<token>
PUBLIC_APP_URL=http://localhost:5180
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_LINK_KEY=

# Shown on the customer tracking page (TODO: fill in real contact details)
COMPANY_NAME=Sugacoco
COMPANY_SUPPORT_EMAIL=
COMPANY_SUPPORT_PHONE=
# Printed on PI / Quotation PDFs. Use | for new lines.
COMPANY_ADDRESS=
COMPANY_GSTIN=
